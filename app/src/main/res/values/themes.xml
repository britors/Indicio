<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Tema aplicado antes de o Compose assumir. Mantém o neutro frio da
        galeria para que a abertura não pisque em branco puro nem escuro.
    -->
    <style name="Theme.Indicio" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/fundo_galeria</item>
        <item name="android:statusBarColor">@color/fundo_galeria</item>
        <item name="android:navigationBarColor">@color/fundo_galeria</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
