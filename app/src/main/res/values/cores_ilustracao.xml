    <color name="ilustracao_parede">#E6D8BE</color>
    <color name="ilustracao_parede_alta">#EFE3CD</color>
    <color name="ilustracao_piso">#C6AF8C</color>
    <color name="ilustracao_rodape">#A98F6B</color>
    <color name="ilustracao_luz">#F8F1DE</color>
    <color name="ilustracao_sombra">#B49A76</color>

    <!-- Madeira e mobiliário -->
    <color name="ilustracao_madeira">#7A5A3A</color>
    <color name="ilustracao_madeira_clara">#9C7A50</color>
    <color name="ilustracao_feltro">#3D5A50</color>

    <!-- Identidade -->
    <color name="ilustracao_marinho">#1B2A41</color>
    <color name="ilustracao_marinho_claro">#2E4665</color>
    <color name="ilustracao_dourado">#8A6A1F</color>
