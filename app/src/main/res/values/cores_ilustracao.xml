    <color name="ilustracao_luz">#F7FBFA</color>
    <color name="ilustracao_sombra">#91A8A1</color>

    <!-- Mobiliário da exposição -->
    <color name="ilustracao_madeira">#4D6670</color>
    <color name="ilustracao_madeira_clara">#708A92</color>
    <color name="ilustracao_feltro">#2E6A5F</color>

    <!-- Identidade -->
    <color name="ilustracao_marinho">#183B4E</color>
    <color name="ilustracao_marinho_claro">#315B70</color>
    <color name="ilustracao_dourado">#A77A16</color>
