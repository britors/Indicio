<?xml version="1.0" encoding="utf-8"?>
<!--
    Paleta das ilustrações de cena.

    Vive em recursos, e não em ui/tema/Cores.kt, porque quem consome são os
    vector drawables em res/drawable. Os tons derivam da mesma identidade de
    papel/sépia, azul-marinho e dourado envelhecido do tema.
-->
<resources>
